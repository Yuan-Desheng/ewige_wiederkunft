formulas:
  进度: |-
    if(number(progress), 
       html("<div style='background: radial-gradient(closest-side, var(--background-primary) 70%, transparent 71% 100%), conic-gradient(" + 
            if(progress >= 80, "var(--color-green)",
               if(progress >= 60, "var(--color-yellow)",
                  if(progress >= 40, "var(--color-orange)",
                     "var(--color-red)"))) + 
            " " + min(max(progress, 0), 100) + "%, var(--background-modifier-border) 0); width: 20px; height: 20px; border-radius: 50%; display: inline-block;' title='" + min(max(progress, 0), 100) + "%'></div>"), 
       html("<div style='background: radial-gradient(closest-side, var(--background-primary) 70%, transparent 71% 100%), conic-gradient(var(--color-red) 0%, var(--background-modifier-border) 0); width: 20px; height: 20px; border-radius: 50%; display: inline-block;' title='0%'></div>")
    )
  修改时间: file.mtime.relative()
properties:
  file.name:
    displayName: 文件名
  property.tags:
    displayName: 标签
  file.folder:
    displayName: 路径
  file.ctime:
    displayName: 创建时间
  file.ext:
    displayName: 格式
  property.country:
    displayName: 国家
  property.datePublished:
    displayName: 出版日期
  property.director:
    displayName: 导演
  property.score:
    displayName: 评分
  property.desc:
    displayName: 简介
  property.今日喝水量:
    displayName: 喝水量(ml)
  property.读书时长:
    displayName: 读书时长(min)
  property.回顾打卡:
    displayName: 🔗
  property.运动时长:
    displayName: 运动时长(h)
  property.今日心情:
    displayName: 🙂
  property.运动打卡:
    displayName: 🏃
  property.喝水打卡:
    displayName: 💧
  property.读书打卡:
    displayName: 📖
  property.回顾建立联系笔记数量:
    displayName: 每日链接数量(篇)
views:
  - type: table
    name: 文档数据库-IPARA
    filters:
      and:
        - file.path.contains("Documents/I.P.A.R.A")
        - file.ext != "canvas"
        - file.name != "保留此文档不要删"
    order:
      - file.name
      - 笔记类型
      - 卡片盒笔记主题
      - tags
      - formula.进度
      - progress
      - formula.修改时间
    sort:
      - property: formula.修改时间
        direction: DESC
      - property: formula.未命名
        direction: DESC
      - property: formula.反向连接
        direction: DESC
    columnSize:
      file.name: 241
      note.卡片盒笔记主题: 162
      note.tags: 201
      formula.笔记进度: 45
      note.progress: 89
    cardSize: 220
    imageFit: ""
    imageAspectRatio: 1
    rowHeight: ""
  - type: table
    name: 文档数据库-日记
    filters:
      and:
        - file.path.contains("Documents/Dailynote")
    order:
      - file.name
      - 今日心情
      - 运动打卡
      - 喝水打卡
      - 读书打卡
      - 回顾打卡
      - 读书时长
      - 今日喝水量
      - 运动时长
      - 回顾建立联系笔记数量
      - Keep
      - Improve
      - Start
      - Stop
    sort: []
    columnSize:
      file.name: 141
      property.回顾打卡: 51
      property.Keep: 136
      property.Improve: 130
      property.Start: 139
      property.Stop: 133
