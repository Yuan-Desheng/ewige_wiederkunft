  "globalRules": [
    {
      "id": "rule_1755530387418_hqeo7cahl",
      "name": "数学公式格式",
      "content": "公式需要遵循以下Latex格式，并且只输出公式本身（前后$以及包裹的内容，$符号与包裹的内容之间不能有空格），未明确输入公式为单行或多行时，默认使用单行公式\n单行公式：$公式$\n多行公式：\n$$\n公式\n$$",
      "description": "采用Latex格式",
      "category": "format",
      "priority": 9,
      "enabled": true,
      "createdAt": 1755530387418,
      "updatedAt": 1755533815951
    },
    {
      "id": "rule_1755532985773_lk0ybaxay",
      "name": "YAML格式",
      "content": "若笔记中顶部位置包含YAML区域（前后---符号包裹），在输出内容时，需要保持YAML区域前后的---符号不变",
      "description": "YAML格式",
      "category": "format",
      "priority": 9,
      "enabled": true,
      "createdAt": 1755532985773,
      "updatedAt": 1755532985773
    },
    {
      "id": "rule_1755533236905_yik6ximru",
      "name": "属性字段格式",
      "content": "YAML区域内的字段，如果包含tags、aliases、cssclasses字段，其字段值必须采用无序列表数组格式（其中cssclasses字段值不要修改），例如：\ntags: \n - 标签1\n - 标签2\n\naliases:\n - 别名1\n - 别名2",
      "description": "tags、aliases、cssclasses属性",
      "category": "format",
      "priority": 9,
      "enabled": true,
      "createdAt": 1755533236905,
      "updatedAt": 1755533637754
    },
    {
      "id": "rule_1755534125515_lbwla58f9",
      "name": "代码块内容处理",
      "content": "除非提示词明确要求修改代码内容，否则前后```符号包裹的代码块内容（也可能是多个反引号代码块包裹的内容），不允许修改",
      "description": "",
      "category": "custom",
      "priority": 9,
      "enabled": true,
      "createdAt": 1755534125515,
      "updatedAt": 1755534186528
    },
    {
      "id": "rule_1755575228972_f3aunhozx",
      "name": "语言设置",
      "content": "请使用简体中文回复",
      "description": "",
      "category": "language",
